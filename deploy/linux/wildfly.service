[Unit]
Description=WildFly application server (GreenPilot)
After=network-online.target mongod.service mosquitto.service
Wants=network-online.target

[Service]
User=wildfly
Group=wildfly
EnvironmentFile=/etc/greenpilot/wildfly.env
ExecStart=/opt/wildfly/bin/standalone.sh -b 0.0.0.0 -Djboss.http.port=80 -Djboss.https.port=443
# lets the non-root wildfly user listen on ports 80 and 443
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=102642
TimeoutStartSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
