{
  "name": "GreenPilot",
  "short_name": "GreenPilot",
  "description": "Greenhouse monitoring, irrigation and plant health",
  "id": "./",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
